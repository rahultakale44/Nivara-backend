# CampusCare Backend - Environment Variables
# Copy this file to .env and update with your actual values

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/campuscare
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# JWT Configuration
# Generate a secure random string (minimum 32 characters) for production
# Example: openssl rand -base64 32
JWT_SECRET=your-secure-jwt-secret-key-minimum-32-characters-for-production-use

# Server Port (optional, defaults to 8080)
PORT=8080
